{
  "name": "lohra-ts",
  "version": "0.0.11",
  "description": "Headless TypeScript runtime for Lohra",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelusfernandes/lohra-ts.git"
  },
  "homepage": "https://github.com/marcelusfernandes/lohra-ts#readme",
  "bugs": {
    "url": "https://github.com/marcelusfernandes/lohra-ts/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "terminal",
    "workflow",
    "runtime",
    "mcp"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lohra": "dist/cli.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "LICENSE",
    "docs/closeout.md",
    "scripts/postinstall.mjs"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "node scripts/prepare.mjs",
    "doutor": "tsx scripts/doutor.ts",
    "mutations:t20": "tsx scripts/mutations/web-tools.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mutations:t16": "tsx scripts/mutations/workflow-durability.ts",
    "mutations:t17": "tsx scripts/mutations/workflow-audit-live.ts",
    "mutations:t15": "tsx scripts/mutations/workflow-executor.ts",
    "mutations:t21": "tsx scripts/mutations/media.ts",
    "mutations:self-update": "tsx scripts/mutations/self-update.ts",
    "mutations:t23": "tsx scripts/mutations/context-window.ts",
    "mutations:auth": "tsx scripts/mutations/auth.ts",
    "mutations:supervision": "tsx scripts/mutations/supervision.ts",
    "mutations:all": "tsx scripts/mutations/all.ts",
    "pack:check": "tsx scripts/pack-check.ts",
    "provenance:check": "tsx scripts/provenance/check-ancestry.ts",
    "prova": "tsx scripts/prova/run.ts",
    "ci:contratos": "tsx scripts/ci/contratos/run.ts",
    "ci:controle-negativo": "tsx scripts/ci/controle-negativo/run.ts",
    "ci:escopo": "tsx scripts/ci/escopo/run.ts",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "node-pty": "https://registry.npmjs.org/node-pty/-/node-pty-1.1.0.tgz",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.9.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
