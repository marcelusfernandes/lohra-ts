{
  "name": "lohra-ts",
  "version": "0.0.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lohra": "dist/cli.js"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "parity": "tsx scripts/parity/cli.ts",
    "parity:auth": "tsx scripts/parity/auth/run-all.ts",
    "parity:context": "tsx scripts/parity/local-context/run-all.ts",
    "parity:chat-completions": "tsx scripts/parity/chat-completions/run-all.ts",
    "parity:workflow-spec": "tsx scripts/parity/workflow-spec/run-all.ts",
    "parity:t08": "tsx scripts/parity/cli.ts",
    "parity:t08:all": "tsx scripts/parity/conversation/run-all.ts",
    "probe:t08": "node scripts/parity/conversation/ts-only-probes.mjs",
    "probe:t08:live-scrub": "node scripts/parity/conversation/live-smoke.mjs --canary",
    "smoke:t08:live": "node scripts/parity/conversation/live-smoke.mjs",
    "probe:workflow-spec-ts-only": "node scripts/parity/workflow-spec/ts-only-probes.mjs",
    "probe:chat-completions-ts-only": "node scripts/parity/chat-completions/ts-only-probe.mjs",
    "probe:chat-completions-live-scrub": "node scripts/parity/chat-completions/live-smoke.mjs --canary",
    "smoke:chat-completions-live": "node scripts/parity/chat-completions/live-smoke.mjs",
    "probe:local-context-ts-only": "node scripts/parity/local-context/ts-only-probes.mjs",
    "probe:state-cross-read": "node scripts/parity/state/cross-read.mjs",
    "probe:state-multiprocess": "node scripts/parity/state/multiprocess.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "tsx scripts/pack-check.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
