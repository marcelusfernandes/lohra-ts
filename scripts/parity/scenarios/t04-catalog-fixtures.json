{
  "schemaVersion": 1,
  "id": "t04-catalog-fixtures",
  "description": "Injected catalog responses and request policy",
  "argv": [],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "NO_COLOR": "1",
      "COLUMNS": "80",
      "HOME": "{{home}}",
      "TMPDIR": "{{home}}/tmp",
      "LOHRA_HOME": "{{profile}}"
    }
  },
  "preconditions": [],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": [
        "{{projectRoot}}/scripts/parity/providers/oracle_driver.py",
        "catalog-fixtures"
      ],
      "cwd": "sandbox"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": [
        "{{projectRoot}}/scripts/parity/providers/candidate-driver.mjs",
        "catalog-fixtures"
      ],
      "cwd": "sandbox"
    }
  },
  "limits": { "timeoutMs": 30000, "maxOutputBytes": 4194304 },
  "capture": {
    "tree": { "enabled": true, "root": "profile", "exclude": [] },
    "sqlite": [],
    "events": []
  },
  "comparisons": [
    { "class": "byte", "field": "process.exitCode" },
    { "class": "byte", "field": "process.signal" },
    { "class": "probe", "field": "process.stdout" },
    { "class": "byte", "field": "process.stderr" },
    { "class": "schema", "field": "tree" }
  ],
  "expectations": [
    { "side": "both", "field": "process.exitCode", "value": 0 },
    { "side": "both", "field": "process.signal", "value": null },
    { "side": "both", "field": "process.stderr", "encoding": "utf8", "value": "" },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/0/entry/models",
      "value": ["b", "a"]
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/4/entry/detail",
      "value": "first page only (1 ids) — the provider has more"
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/8/entry/detail",
      "value": "HTTP 401"
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/9/entry/detail",
      "value": "reachable, no models listed"
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/10/entry/detail",
      "value": "response too large (> 4000000 B)"
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/0/request/identity",
      "value": "identity"
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/11/request/auth",
      "value": ["anthropic-version", "x-api-key"]
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/12/request/auth",
      "value": ["authorization"]
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/13/request/auth",
      "value": []
    }
  ],
  "normalizations": [],
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
