{
  "schemaVersion": 1,
  "id": "t07-client-stream-nodone-no-tools",
  "description": "T07 chat-completions transport: client-stream-nodone-no-tools",
  "argv": [],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
