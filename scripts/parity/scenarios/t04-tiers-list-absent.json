{
  "schemaVersion": 1,
  "id": "t04-tiers-list-absent",
  "description": "Absent tier file is read-only",
  "argv": ["tiers", "list"],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "NO_COLOR": "1",
      "COLUMNS": "80"
    }
  },
  "preconditions": [{ "kind": "tcp-port-closed", "host": "127.0.0.1", "port": 11434 }],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-lohra",
      "prefixArgs": [],
      "cwd": "sandbox"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/dist/cli.js"],
      "cwd": "sandbox"
    }
  },
  "limits": { "timeoutMs": 15000, "maxOutputBytes": 2097152 },
  "capture": {
    "tree": { "enabled": true, "root": "home", "exclude": [] },
    "sqlite": [],
    "events": []
  },
  "comparisons": [
    { "class": "byte", "field": "process.exitCode" },
    { "class": "byte", "field": "process.signal" },
    { "class": "byte", "field": "process.stdout" },
    { "class": "byte", "field": "process.stderr" },
    { "class": "schema", "field": "tree" }
  ],
  "expectations": [
    { "side": "both", "field": "process.exitCode", "value": 0 },
    { "side": "both", "field": "process.signal", "value": null },
    { "side": "both", "field": "process.stderr", "encoding": "utf8", "value": "" },
    { "side": "both", "field": "tree", "value": [{ "path": "tmp", "type": "directory" }] }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-runtime-path",
      "source": "home",
      "replacement": "<HOME>"
    }
  ],
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n"
  }
}
