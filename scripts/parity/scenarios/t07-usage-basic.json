{
  "schemaVersion": 1,
  "id": "t07-usage-basic",
  "description": "T07 chat-completions transport: usage-basic",
  "argv": [],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
