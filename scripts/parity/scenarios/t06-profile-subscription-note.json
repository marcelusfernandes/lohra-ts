{
  "schemaVersion": 1,
  "id": "t06-profile-subscription-note",
  "description": "T06 local context/onboarding: t06-profile-subscription-note",
  "argv": ["profile", "create", "subless"],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "NO_COLOR": "1",
      "COLUMNS": "80",
      "TZ": "UTC",
      "HOME": "{{home}}",
      "CODEX_HOME": "{{home}}/codex",
      "TMPDIR": "{{home}}/tmp",
      "LOHRA_HOME": "{{profile}}"
    }
  },
  "preconditions": [],
  "fixtures": [
    {
      "root": "profile",
      "path": "auth.json",
      "encoding": "utf8",
      "content": "{\"openai\":{\"auth_mode\":\"subscription\",\"acknowledged_tos_risk\":true,\"preference\":\"auto\"}}"
    }
  ],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-lohra",
      "prefixArgs": [],
      "cwd": "sandbox"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/dist/cli.js"],
      "cwd": "sandbox"
    }
  },
  "limits": {
    "timeoutMs": 15000,
    "maxOutputBytes": 4194304
  },
  "capture": {
    "tree": {
      "enabled": true,
      "root": "profile",
      "exclude": []
    },
    "sqlite": [],
    "events": []
  },
  "comparisons": [
    {
      "class": "byte",
      "field": "process.exitCode"
    },
    {
      "class": "byte",
      "field": "process.signal"
    },
    {
      "class": "probe",
      "field": "process.stdout"
    },
    {
      "class": "byte",
      "field": "process.stderr"
    },
    {
      "class": "schema",
      "field": "tree"
    }
  ],
  "expectations": [
    {
      "side": "both",
      "field": "process.exitCode",
      "value": 0
    },
    {
      "side": "both",
      "field": "process.signal",
      "value": null
    },
    {
      "side": "both",
      "field": "process.stderr",
      "encoding": "utf8",
      "value": ""
    },
    {
      "side": "both",
      "field": "tree",
      "pointer": "/0/path",
      "value": "auth.json"
    }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-runtime-path",
      "source": "profile",
      "replacement": "<PROFILE>"
    }
  ],
  "scrub": {
    "fixtureTokens": true,
    "operatorCredentials": true
  },
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n",
    "expectedPythonVersion": "3.12.10"
  }
}
