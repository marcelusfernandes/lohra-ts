{
  "schemaVersion": 1,
  "id": "t03-locks-sequential",
  "description": "Compression TTL, fence 1-2-3 and non-silent stale write refusal",
  "argv": [],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "NO_COLOR": "1",
      "COLUMNS": "80",
      "HOME": "{{home}}",
      "TMPDIR": "{{home}}/tmp",
      "LOHRA_HOME": "{{profile}}"
    }
  },
  "preconditions": [],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/state/oracle_driver.py", "locks-sequential"],
      "cwd": "sandbox"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": [
        "{{projectRoot}}/scripts/parity/state/candidate-driver.mjs",
        "locks-sequential"
      ],
      "cwd": "sandbox"
    }
  },
  "limits": { "timeoutMs": 60000, "maxOutputBytes": 16777216 },
  "capture": {
    "tree": { "enabled": false, "root": "profile", "exclude": [] },
    "sqlite": [
      {
        "name": "locks",
        "root": "profile",
        "path": "state.db",
        "pragmas": ["journal_mode", "quick_check"],
        "tables": [
          { "name": "compression_locks", "orderBy": ["session_id"] },
          { "name": "workflow_run_locks", "orderBy": ["run_id"] },
          { "name": "workflow_run_fence", "orderBy": ["run_id"] },
          { "name": "workflow_run_state", "orderBy": ["run_id"] }
        ]
      }
    ],
    "events": []
  },
  "comparisons": [
    { "class": "byte", "field": "process.exitCode" },
    { "class": "byte", "field": "process.signal" },
    { "class": "byte", "field": "process.stdout" },
    { "class": "byte", "field": "process.stderr" },
    { "class": "schema", "field": "sqlite.locks" }
  ],
  "expectations": [
    { "side": "both", "field": "process.exitCode", "value": 0 },
    { "side": "both", "field": "process.signal", "value": null },
    { "side": "both", "field": "process.stderr", "encoding": "utf8", "value": "" },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/fences",
      "value": [1, 2, 3]
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/staleAccepted",
      "value": false
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/warnings/0",
      "value": { "cause": "STALE_FENCE_WRITE", "runId": "run-stale", "fence": 1 }
    }
  ],
  "normalizations": [
    {
      "field": "sqlite.locks",
      "kind": "replace-json-pointer",
      "pointer": "/schema/17/sql",
      "replacement": "<WORKFLOW_AUDIT_EVENTS_SCHEMA>"
    }
  ],
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n",
    "expectedPythonVersion": "3.12.10"
  }
}
