{
  "schemaVersion": 1,
  "id": "t03-profile-isolation",
  "description": "Default, p1 and p2 state databases remain path- and row-isolated",
  "argv": [],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "NO_COLOR": "1",
      "COLUMNS": "80",
      "HOME": "{{home}}",
      "TMPDIR": "{{home}}/tmp",
      "LOHRA_HOME": "{{profile}}"
    }
  },
  "preconditions": [],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/state/oracle_driver.py", "profile-isolation"],
      "cwd": "sandbox"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": [
        "{{projectRoot}}/scripts/parity/state/candidate-driver.mjs",
        "profile-isolation"
      ],
      "cwd": "sandbox"
    }
  },
  "limits": { "timeoutMs": 60000, "maxOutputBytes": 16777216 },
  "capture": {
    "tree": { "enabled": false, "root": "profile", "exclude": [] },
    "sqlite": [
      {
        "name": "default",
        "root": "profile",
        "path": "state.db",
        "pragmas": ["journal_mode", "user_version"],
        "tables": [{ "name": "sessions", "orderBy": ["id"] }]
      },
      {
        "name": "p1",
        "root": "profile",
        "path": "profiles/p1/state.db",
        "pragmas": ["journal_mode", "user_version"],
        "tables": [{ "name": "sessions", "orderBy": ["id"] }]
      },
      {
        "name": "p2",
        "root": "profile",
        "path": "profiles/p2/state.db",
        "pragmas": ["journal_mode", "user_version"],
        "tables": [{ "name": "sessions", "orderBy": ["id"] }]
      }
    ],
    "events": []
  },
  "comparisons": [
    { "class": "byte", "field": "process.exitCode" },
    { "class": "byte", "field": "process.signal" },
    { "class": "byte", "field": "process.stdout" },
    { "class": "byte", "field": "process.stderr" },
    { "class": "schema", "field": "sqlite.default" },
    { "class": "schema", "field": "sqlite.p1" },
    { "class": "schema", "field": "sqlite.p2" }
  ],
  "expectations": [
    { "side": "both", "field": "process.exitCode", "value": 0 },
    { "side": "both", "field": "process.signal", "value": null },
    { "side": "both", "field": "process.stderr", "encoding": "utf8", "value": "" },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/visible",
      "value": { "default": ["default"], "p1": ["one"], "p2": ["two"] }
    }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-runtime-path",
      "source": "profile",
      "replacement": "<PROFILE>"
    }
  ],
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n",
    "expectedPythonVersion": "3.12.10"
  }
}
