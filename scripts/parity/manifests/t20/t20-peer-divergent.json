{
  "schemaVersion": 1,
  "id": "t20-peer-divergent",
  "description": "T20 bilateral observation: peer-divergent (expected divergent)",
  "argv": ["peer-divergent"],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "PYTHONHASHSEED": "0",
      "NO_COLOR": "1",
      "TZ": "UTC",
      "HOME": "{{home}}",
      "TMPDIR": "{{home}}/tmp",
      "HTTP_PROXY": "http://127.0.0.1:1",
      "HTTPS_PROXY": "http://127.0.0.1:1",
      "ALL_PROXY": "http://127.0.0.1:1"
    }
  },
  "preconditions": [],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/web-tools/oracle_driver.py"],
      "cwd": "profile"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/web-tools/candidate-driver.mjs"],
      "cwd": "profile"
    }
  },
  "limits": {
    "timeoutMs": 60000,
    "maxOutputBytes": 16777216
  },
  "capture": {
    "tree": {
      "enabled": false,
      "root": "profile",
      "exclude": []
    },
    "sqlite": [],
    "events": []
  },
  "comparisons": [
    {
      "class": "byte",
      "field": "process.exitCode"
    },
    {
      "class": "byte",
      "field": "process.signal"
    },
    {
      "class": "byte",
      "field": "process.stdout"
    }
  ],
  "expectations": [
    {
      "side": "both",
      "field": "process.exitCode",
      "value": 0
    },
    {
      "side": "both",
      "field": "process.signal",
      "value": null
    },
    {
      "side": "oracle",
      "field": "process.stdout",
      "encoding": "utf8",
      "value": "{\"authorization\": [], \"bodyBytesRead\": 24, \"dns\": [\"divergent.test\"], \"parserCalls\": 0, \"requestBodies\": [\"\"], \"requests\": [\"http://divergent.test/\"], \"result\": {\"ok\": true, \"text\": \"SIMULATED_DIVERGENT_BODY\", \"url\": \"http://divergent.test/\"}}\n"
    },
    {
      "side": "candidate",
      "field": "process.stdout",
      "encoding": "utf8",
      "value": "{\"authorization\": [], \"bodyBytesRead\": 0, \"dns\": [\"divergent.test\"], \"parserCalls\": 0, \"requestBodies\": [\"\"], \"requests\": [\"http://divergent.test/\"], \"result\": {\"error\": \"refusing response from unvalidated peer: peer not in validated set\", \"url\": \"http://divergent.test/\"}}\n"
    }
  ],
  "normalizations": [],
  "scrub": {
    "fixtureTokens": true,
    "operatorCredentials": true
  },
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
