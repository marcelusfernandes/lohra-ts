{
  "schemaVersion": 1,
  "id": "t20-definitions",
  "description": "T20 bilateral observation: definitions",
  "argv": ["definitions"],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
