{
  "schemaVersion": 1,
  "id": "t09-public-max-iterations",
  "description": "t09-public-max-iterations",
  "argv": [
    "chat",
    "--json",
    "--provider",
    "ollama",
    "--model",
    "stub-coder:1b",
    "--max-iterations",
    "1",
    "--no-input",
    "--profile",
    "p",
    "t09-public-max-iterations"
  ],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "NO_COLOR": "1",
      "LOHRA_NO_WIZARD": "1",
      "COLUMNS": "80",
      "HOME": "{{home}}",
      "TMPDIR": "{{home}}/tmp"
    }
  },
  "preconditions": [
    {
      "kind": "tcp-port-closed",
      "host": "127.0.0.1",
      "port": 11434
    }
  ],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/oracle_driver.py", "single"],
      "cwd": "profile"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/candidate-driver.mjs", "single"],
      "cwd": "profile"
    }
  },
  "limits": {
    "timeoutMs": 60000,
    "maxOutputBytes": 16777216
  },
  "capture": {
    "tree": {
      "enabled": true,
      "root": "profile",
      "exclude": [
        "stub-requests.jsonl",
        "stub-requests-raw.jsonl",
        "stub-summary.json",
        "stub-assertions.json"
      ]
    },
    "sqlite": [
      {
        "name": "db",
        "root": "home",
        "path": ".lohra/profiles/p/state.db",
        "pragmas": [
          "application_id",
          "encoding",
          "journal_mode",
          "page_size",
          "quick_check",
          "user_version"
        ],
        "tables": [
          {
            "name": "sessions",
            "orderBy": ["id"]
          },
          {
            "name": "messages",
            "orderBy": ["id"]
          }
        ]
      }
    ],
    "events": [
      {
        "name": "requests",
        "root": "profile",
        "path": "stub-requests.jsonl",
        "format": "jsonl"
      },
      {
        "name": "requestsRaw",
        "root": "profile",
        "path": "stub-requests-raw.jsonl",
        "format": "jsonl",
        "projection": "raw-only"
      },
      {
        "name": "summary",
        "root": "profile",
        "path": "stub-summary.json",
        "format": "json"
      },
      {
        "name": "assertions",
        "root": "profile",
        "path": "stub-assertions.json",
        "format": "json"
      }
    ]
  },
  "comparisons": [
    {
      "class": "byte",
      "field": "process.exitCode"
    },
    {
      "class": "byte",
      "field": "process.signal"
    },
    {
      "class": "byte",
      "field": "process.stdout"
    },
    {
      "class": "byte",
      "field": "process.stderr"
    },
    {
      "class": "stub",
      "field": "events.requests"
    },
    {
      "class": "stub",
      "field": "events.summary"
    },
    {
      "class": "stub",
      "field": "events.assertions"
    },
    {
      "class": "schema",
      "field": "tree"
    },
    {
      "class": "schema",
      "field": "sqlite.db"
    }
  ],
  "expectations": [
    {
      "side": "both",
      "field": "process.exitCode",
      "value": 1
    },
    {
      "side": "both",
      "field": "process.signal",
      "value": null
    },
    {
      "side": "both",
      "field": "events.summary",
      "value": {
        "exists": true,
        "records": {
          "gets": 0,
          "posts": 1,
          "sequence": ["POST /v1/chat/completions"]
        }
      }
    },
    {
      "side": "both",
      "field": "events.assertions",
      "value": {
        "exists": true,
        "records": {
          "valid": true,
          "failures": []
        }
      }
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/completed",
      "value": false
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/api_calls",
      "value": 1
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/output",
      "value": null
    },
    {
      "side": "both",
      "field": "sqlite.db",
      "pointer": "/tables/messages/rows",
      "value": []
    },
    {
      "side": "both",
      "field": "sqlite.db",
      "pointer": "/tables/sessions/rows/0/10",
      "value": {
        "type": "integer",
        "decimal": "0"
      }
    },
    {
      "side": "both",
      "field": "sqlite.db",
      "pointer": "/tables/sessions/rows/0/11",
      "value": {
        "type": "integer",
        "decimal": "0"
      }
    },
    {
      "side": "both",
      "field": "sqlite.db",
      "pointer": "/tables/sessions/rows/0/12",
      "value": {
        "type": "integer",
        "decimal": "11"
      }
    },
    {
      "side": "both",
      "field": "sqlite.db",
      "pointer": "/tables/sessions/rows/0/13",
      "value": {
        "type": "integer",
        "decimal": "7"
      }
    },
    {
      "side": "both",
      "field": "sqlite.db",
      "pointer": "/tables/sessions/rows/0/21",
      "value": {
        "type": "integer",
        "decimal": "1"
      }
    },
    {
      "side": "both",
      "field": "sqlite.db",
      "pointer": "/tables/sessions/rows/0/23",
      "value": {
        "type": "integer",
        "decimal": "1"
      }
    }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-json-pointer",
      "pointer": "/session_id",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=session: )[0-9a-f]{32}(?=  \\(resume with --session )",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=--session )[0-9a-f]{32}(?=\\))",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "events.requests",
      "kind": "replace-runtime-path",
      "source": "profile",
      "replacement": "<PROFILE>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-runtime-path",
      "source": "profile",
      "replacement": "<PROFILE>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/sessions/rows/0/0",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/sessions/rows/0/7",
      "replacement": "<TIMESTAMP>"
    }
  ],
  "stub": {
    "state": "up-with-models",
    "fixture": "chat-tool-sequence",
    "requestLog": {
      "comparedHeaders": [
        "authorization",
        "accept",
        "content-type",
        "host",
        "x-stainless-retry-count"
      ],
      "excludedHeaders": [
        "accept-encoding",
        "connection",
        "content-length",
        "user-agent",
        "x-stainless-lang",
        "x-stainless-package-version",
        "x-stainless-os",
        "x-stainless-arch",
        "x-stainless-runtime",
        "x-stainless-runtime-version",
        "x-stainless-async",
        "x-stainless-read-timeout"
      ]
    },
    "toolSequence": [
      {
        "calls": [
          {
            "name": "write_file",
            "argumentsRaw": "{\"path\":\"max-effect.txt\",\"content\":\"executed\"}",
            "expectedResult": "{\"ok\": true, \"bytes_written\": 8, \"path\": \"max-effect.txt\"}",
            "validation": "skip"
          }
        ]
      }
    ]
  },
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n",
    "expectedPythonVersion": "3.12.10",
    "expectedPackages": {
      "openai": "3.6.0",
      "httpx": "0.28.1"
    }
  }
}
