{
  "schemaVersion": 1,
  "id": "t09-public-no-tools-control",
  "description": "t09-public-no-tools-control",
  "argv": [
    "chat",
    "--json",
    "--provider",
    "ollama",
    "--model",
    "stub-coder:1b",
    "--max-iterations",
    "4",
    "--no-input",
    "--profile",
    "p",
    "--no-tools",
    "t09-public-no-tools-control"
  ],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "NO_COLOR": "1",
      "LOHRA_NO_WIZARD": "1",
      "COLUMNS": "80",
      "HOME": "{{home}}",
      "TMPDIR": "{{home}}/tmp"
    }
  },
  "preconditions": [
    {
      "kind": "tcp-port-closed",
      "host": "127.0.0.1",
      "port": 11434
    }
  ],
  "fixtures": [
    {
      "root": "home",
      "path": ".lohra/profiles/p/memories/MEMORY.md",
      "encoding": "utf8",
      "content": "CANARY-MEMORY"
    },
    {
      "root": "home",
      "path": ".lohra/profiles/p/memories/USER.md",
      "encoding": "utf8",
      "content": "CANARY-USER"
    },
    {
      "root": "home",
      "path": ".lohra/profiles/p/skills/home-skill/SKILL.md",
      "encoding": "utf8",
      "content": "---\nname: home-skill\ndescription: home canary\nversion: 1.0.0\n---\nbody\n"
    },
    {
      "root": "profile",
      "path": ".claude/skills/project-skill/SKILL.md",
      "encoding": "utf8",
      "content": "---\nname: project-skill\ndescription: project canary\nversion: 1.0.0\n---\nbody\n"
    }
  ],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": [
        "{{projectRoot}}/scripts/parity/conversation/oracle_driver.py",
        "single"
      ],
      "cwd": "profile"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": [
        "{{projectRoot}}/scripts/parity/conversation/candidate-driver.mjs",
        "single"
      ],
      "cwd": "profile"
    }
  },
  "limits": {
    "timeoutMs": 60000,
    "maxOutputBytes": 16777216
  },
  "capture": {
    "tree": {
      "enabled": false,
      "root": "home",
      "exclude": []
    },
    "sqlite": [
      {
        "name": "db",
        "root": "home",
        "path": ".lohra/profiles/p/state.db",
        "pragmas": [
          "application_id",
          "encoding",
          "journal_mode",
          "page_size",
          "quick_check",
          "user_version"
        ],
        "tables": [
          {
            "name": "sessions",
            "orderBy": [
              "id"
            ]
          },
          {
            "name": "messages",
            "orderBy": [
              "id"
            ]
          }
        ]
      }
    ],
    "events": [
      {
        "name": "requests",
        "root": "profile",
        "path": "stub-requests.jsonl",
        "format": "jsonl"
      },
      {
        "name": "requestsRaw",
        "root": "profile",
        "path": "stub-requests-raw.jsonl",
        "format": "jsonl",
        "projection": "raw-only"
      },
      {
        "name": "summary",
        "root": "profile",
        "path": "stub-summary.json",
        "format": "json"
      },
      {
        "name": "assertions",
        "root": "profile",
        "path": "stub-assertions.json",
        "format": "json"
      }
    ]
  },
  "comparisons": [
    {
      "class": "byte",
      "field": "process.exitCode"
    },
    {
      "class": "byte",
      "field": "process.signal"
    },
    {
      "class": "byte",
      "field": "process.stdout"
    },
    {
      "class": "byte",
      "field": "process.stderr"
    },
    {
      "class": "stub",
      "field": "events.requests"
    },
    {
      "class": "stub",
      "field": "events.summary"
    },
    {
      "class": "stub",
      "field": "events.assertions"
    },
    {
      "class": "schema",
      "field": "sqlite.db"
    }
  ],
  "expectations": [
    {
      "side": "both",
      "field": "process.exitCode",
      "value": 0
    },
    {
      "side": "both",
      "field": "process.signal",
      "value": null
    },
    {
      "side": "both",
      "field": "events.summary",
      "value": {
        "exists": true,
        "records": {
          "gets": 0,
          "posts": 1,
          "sequence": [
            "POST /v1/chat/completions"
          ]
        }
      }
    },
    {
      "side": "both",
      "field": "events.assertions",
      "value": {
        "exists": true,
        "records": {
          "valid": true,
          "failures": []
        }
      }
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/completed",
      "value": true
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/api_calls",
      "value": 1
    }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-json-pointer",
      "pointer": "/session_id",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=session: )[0-9a-f]{32}(?=  \\(resume with --session )",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=--session )[0-9a-f]{32}(?=\\))",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-runtime-path",
      "source": "profile",
      "replacement": "<PROFILE>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/sessions/rows/0/0",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/sessions/rows/0/7",
      "replacement": "<TIMESTAMP>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-regex",
      "pattern": "Today's date is \\d{4}-\\d{2}-\\d{2}\\.",
      "replacement": "Today's date is <DATE>.",
      "hashOnly": true
    },
    {
      "field": "events.requests",
      "kind": "replace-runtime-path",
      "source": "profile",
      "replacement": "<PROFILE>"
    },
    {
      "field": "events.requests",
      "kind": "replace-regex",
      "pattern": "Today's date is \\d{4}-\\d{2}-\\d{2}\\.",
      "replacement": "Today's date is <DATE>.",
      "hashOnly": true
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/messages/rows/0/1",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/messages/rows/0/7",
      "replacement": "<TIMESTAMP>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/messages/rows/1/1",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "sqlite.db",
      "kind": "replace-json-pointer",
      "pointer": "/tables/messages/rows/1/7",
      "replacement": "<TIMESTAMP>"
    }
  ],
  "stub": {
    "state": "up-with-models",
    "fixture": "chat-text",
    "requestLog": {
      "comparedHeaders": [
        "authorization",
        "accept",
        "content-type",
        "host",
        "x-stainless-retry-count"
      ],
      "excludedHeaders": [
        "accept-encoding",
        "connection",
        "content-length",
        "user-agent",
        "x-stainless-lang",
        "x-stainless-package-version",
        "x-stainless-os",
        "x-stainless-arch",
        "x-stainless-runtime",
        "x-stainless-runtime-version",
        "x-stainless-async",
        "x-stainless-read-timeout"
      ]
    }
  },
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n",
    "expectedPythonVersion": "3.12.10",
    "expectedPackages": {
      "openai": "3.6.0",
      "httpx": "0.28.1"
    }
  }
}
