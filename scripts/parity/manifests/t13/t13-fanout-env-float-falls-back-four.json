{
  "schemaVersion": 1,
  "id": "t13-fanout-env-float-falls-back-four",
  "description": "T13 round-2 bilateral fan-out matrix (env 3.0 falls back to 4), closing contract assertion 24/F4. This is a deterministic exact-concurrency proof, not a startup-warning proxy: 4 blocker children are spawned one at a time, and each next spawn is withheld by the harness until the previous child has reached its gated first request. Child 5 is then spawned and steered while the first 4 slots are occupied. If effective concurrency is below 4, the next blocker never arrives and the scenario times out; if it is above 4, child 5 starts before steer and its first request lacks the asserted system-reminder. Only exactly 4 satisfies both halves. No sleep, ambient credentials, or external egress.",
  "argv": [
    "chat",
    "SCEN:parent t13-fanout-env-float-falls-back-four",
    "--json",
    "--provider",
    "ollama",
    "--model",
    "stub-coder:1b"
  ],
  "environment": {
    "allow": ["LOHRA_MAX_PARALLEL"],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "PYTHONHASHSEED": "0",
      "NO_COLOR": "1",
      "LOHRA_NO_WIZARD": "1",
      "COLUMNS": "80",
      "TZ": "UTC",
      "HOME": "{{home}}",
      "LOHRA_HOME": "{{home}}/.lohra",
      "CODEX_HOME": "{{home}}/codex",
      "TMPDIR": "{{home}}/tmp",
      "LOHRA_MAX_PARALLEL": "3.0"
    }
  },
  "preconditions": [
    {
      "kind": "tcp-port-closed",
      "host": "127.0.0.1",
      "port": 11434
    }
  ],
  "fixtures": [],
