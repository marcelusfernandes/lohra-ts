{
  "schemaVersion": 1,
  "id": "t13-uncollected-failure-silent-wire-logged-to-file",
  "description": "T13 bilateral CLI observation (expected match): a spawn_session child, never collected by the parent, fails on its own (only) upstream call with an HTTP 418 canary while gated during the parent's teardown drain. Deterministic by construction — the outcome does not depend on which side's cooperative-interrupt check wins a race, since the child's single call always resolves to the same upstream error once its gate opens, regardless of timing. Covers decision 14/ADR-T13-04 (uncollected child failure is silent on stdout/stderr, cause elsewhere) and the 'resolves error during drain' half of assertion 41 (shutdown does not swallow failures — it logs the cause). KNOWN LIMIT (declared, not a gap to fix): events.orchestrationLog is captured and checked via candidate-only expectations (side:\"candidate\"), never added to bilateral comparisons — the oracle has no equivalent file on this path (its own silent-failure channel is a separate mechanism, out of scope here), so comparing it would always mismatch on /exists alone. Consequently the reproducibility digest (projectionSha256) is NOT byte-stable run to run: the log's own subId and at fields are unnormalized and genuinely random/time-varying per run. Reproducibility here means comparison.verdict stays \"match\" and expectations.failures stays empty across repeated runs (verified 5/5) — not digest equality.",
  "argv": [
    "chat",
    "SCEN:parent spawn a child that will fail upstream",
    "--json",
    "--provider",
    "ollama",
    "--model",
    "stub-coder:1b"
  ],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "PYTHONHASHSEED": "0",
      "NO_COLOR": "1",
      "LOHRA_NO_WIZARD": "1",
      "COLUMNS": "80",
      "TZ": "UTC",
      "HOME": "{{home}}",
      "LOHRA_HOME": "{{home}}/.lohra",
      "CODEX_HOME": "{{home}}/codex",
      "TMPDIR": "{{home}}/tmp"
    }
  },
  "preconditions": [
    {
      "kind": "tcp-port-closed",
      "host": "127.0.0.1",
      "port": 11434
    }
  ],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/oracle_driver.py", "single"],
      "cwd": "profile"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/candidate-driver.mjs", "single"],
      "cwd": "profile"
    }
  },
  "limits": {
    "timeoutMs": 20000,
    "maxOutputBytes": 16777216
  },
  "capture": {
    "tree": {
      "enabled": false,
      "root": "home",
      "exclude": []
    },
    "sqlite": [],
    "events": [
      {
        "name": "summary",
        "root": "profile",
        "path": "stub-summary.json",
        "format": "json"
      },
      {
        "name": "assertions",
        "root": "profile",
        "path": "stub-assertions.json",
        "format": "json"
      },
      {
        "name": "orchestrationLog",
        "root": "home",
        "path": ".lohra/logs/orchestration.log",
        "format": "jsonl"
      }
    ]
  },
  "comparisons": [
    {
      "class": "byte",
      "field": "process.exitCode"
    },
    {
      "class": "byte",
      "field": "process.signal"
    },
    {
      "class": "byte",
      "field": "process.stdout"
    },
    {
      "class": "byte",
      "field": "process.stderr"
    },
    {
      "class": "stub",
      "field": "events.summary"
    },
    {
      "class": "stub",
      "field": "events.assertions"
    }
  ],
  "expectations": [
    {
      "side": "both",
      "field": "process.exitCode",
      "value": 0
    },
    {
      "side": "both",
      "field": "process.signal",
      "value": null
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/completed",
      "value": true
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/error",
      "value": null
    },
    {
      "side": "both",
      "field": "events.assertions",
      "value": {
        "exists": true,
        "records": {
          "valid": true,
          "failures": []
        }
      }
    },
    {
      "side": "both",
      "field": "events.summary",
      "value": {
        "exists": true,
        "records": {
          "gets": 0,
          "posts": 3,
          "sequence": [
            "POST /v1/chat/completions",
            "POST /v1/chat/completions",
            "POST /v1/chat/completions"
          ]
        }
      }
    },
    {
      "side": "candidate",
      "field": "events.orchestrationLog",
      "pointer": "/exists",
      "value": true
    },
    {
      "side": "candidate",
      "field": "events.orchestrationLog",
      "pointer": "/records/0/status",
      "value": "error"
    }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-json-pointer",
      "pointer": "/session_id",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stdout",
      "kind": "replace-regex",
      "pattern": "[0-9a-f]{32}",
      "replacement": "<SUB_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=session: )[0-9a-f]{32}(?=  \\(resume with --session )",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=--session )[0-9a-f]{32}(?=\\))",
      "replacement": "<SESSION_ID>"
    }
  ],
  "stub": {
    "state": "up-with-models",
    "fixture": "chat-lane-script",
    "requestLog": {
