{
  "schemaVersion": 1,
  "id": "t13-delegate-child-terminal-nonstring-divergence",
  "description": "T13 bilateral CLI observation (expected divergent): a delegate_task child receives a non-string terminal command; the parent's own observable turn (stdout) is identical on both sides, but the child's dispatch-layer rejection literal diverges exactly per decision 3 / errata E2, visible only in the raw request log.",
  "argv": [
    "chat",
    "SCEN:parent delegate one background check",
    "--json",
    "--provider",
    "ollama",
    "--model",
    "stub-coder:1b"
  ],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "PYTHONHASHSEED": "0",
      "NO_COLOR": "1",
      "LOHRA_NO_WIZARD": "1",
      "COLUMNS": "80",
      "TZ": "UTC",
      "HOME": "{{home}}",
      "LOHRA_HOME": "{{home}}/.lohra",
      "CODEX_HOME": "{{home}}/codex",
      "TMPDIR": "{{home}}/tmp"
    }
  },
  "preconditions": [
    {
      "kind": "tcp-port-closed",
      "host": "127.0.0.1",
      "port": 11434
    }
  ],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/oracle_driver.py", "single"],
      "cwd": "profile"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/candidate-driver.mjs", "single"],
      "cwd": "profile"
    }
  },
  "limits": {
    "timeoutMs": 20000,
    "maxOutputBytes": 16777216
  },
  "capture": {
    "tree": {
      "enabled": false,
      "root": "home",
      "exclude": []
    },
    "sqlite": [],
    "events": [
      {
        "name": "requests",
        "root": "profile",
        "path": "stub-requests.jsonl",
        "format": "jsonl"
      },
      {
        "name": "requestsRaw",
        "root": "profile",
        "path": "stub-requests-raw.jsonl",
        "format": "jsonl",
        "projection": "raw-only"
      },
      {
        "name": "summary",
        "root": "profile",
        "path": "stub-summary.json",
        "format": "json"
      },
      {
        "name": "assertions",
        "root": "profile",
        "path": "stub-assertions.json",
        "format": "json"
      }
    ]
  },
  "comparisons": [
    {
      "class": "byte",
      "field": "process.exitCode"
    },
    {
      "class": "byte",
      "field": "process.signal"
    },
    {
      "class": "byte",
      "field": "process.stdout"
    },
    {
      "class": "byte",
      "field": "process.stderr"
    },
    {
      "class": "stub",
      "field": "events.requests"
    },
    {
      "class": "stub",
      "field": "events.summary"
    }
  ],
  "expectations": [
    {
      "side": "both",
      "field": "process.exitCode",
      "value": 0
    },
    {
      "side": "both",
      "field": "process.signal",
      "value": null
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/completed",
      "value": true
    },
    {
      "side": "both",
      "field": "events.summary",
      "value": {
        "exists": true,
        "records": {
          "gets": 0,
          "posts": 4,
          "sequence": [
            "POST /v1/chat/completions",
            "POST /v1/chat/completions",
            "POST /v1/chat/completions",
            "POST /v1/chat/completions"
          ]
        }
      }
    },
    {
      "side": "oracle",
      "field": "events.requests",
      "pointer": "/records/2/body/messages/3/content",
      "value": "{\"error\": \"missing required argument 'command' (string)\"}"
    },
    {
      "side": "candidate",
      "field": "events.requests",
      "pointer": "/records/2/body/messages/3/content",
      "value": "{\"error\": \"command was not approved by the user\", \"command\": [\"sudo\", \"x\"]}"
    }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-json-pointer",
      "pointer": "/session_id",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stdout",
      "kind": "replace-regex",
      "pattern": "[0-9a-f]{32}",
      "replacement": "<SUB_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=session: )[0-9a-f]{32}(?=  \\(resume with --session )",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=--session )[0-9a-f]{32}(?=\\))",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "events.requests",
      "kind": "replace-runtime-path",
      "source": "profile",
      "replacement": "<PROJECT>"
    },
    {
      "field": "events.requests",
      "kind": "replace-json-pointer",
      "pointer": "/records/3/body/messages/3/content",
      "replacement": "<DELEGATE_RESULT>"
    }
  ],
  "stub": {
    "state": "up-with-models",
    "fixture": "chat-lane-script",
    "requestLog": {
      "comparedHeaders": [
        "authorization",
        "accept",
        "content-type",
        "host",
        "x-stainless-retry-count"
      ],
      "excludedHeaders": [
        "accept-encoding",
        "connection",
        "content-length",
        "user-agent",
        "x-stainless-lang",
        "x-stainless-package-version",
        "x-stainless-os",
        "x-stainless-arch",
        "x-stainless-runtime",
        "x-stainless-runtime-version",
        "x-stainless-async",
        "x-stainless-read-timeout"
      ]
    },
    "laneSteps": {
      "parent": [
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "delegate_task",
              "argumentsRaw": "{\"tasks\":[\"SCEN:kid try a restricted command\"]}"
            }
          ]
        },
        {
          "kind": "text",
          "content": "PARENT-DONE"
        }
      ],
      "kid": [
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "terminal",
              "argumentsRaw": "{\"command\":[\"sudo\",\"x\"]}"
            }
          ]
        },
        {
          "kind": "text",
          "content": "KID-DONE"
        }
      ]
    }
  },
  "scrub": {
    "fixtureTokens": true,
    "operatorCredentials": true
  },
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n",
    "expectedPythonVersion": "3.12.10",
    "expectedPackages": {
      "openai": "3.6.0",
      "httpx": "0.28.1"
    }
  }
}
