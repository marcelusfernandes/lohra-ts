      "NO_COLOR": "1",
      "LOHRA_NO_WIZARD": "1",
      "COLUMNS": "80",
      "TZ": "UTC",
      "HOME": "{{home}}",
      "LOHRA_HOME": "{{home}}/.lohra",
      "CODEX_HOME": "{{home}}/codex",
