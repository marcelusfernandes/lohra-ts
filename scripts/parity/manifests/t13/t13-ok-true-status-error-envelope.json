{
  "schemaVersion": 1,
  "id": "t13-ok-true-status-error-envelope",
  "description": "T13 bilateral CLI observation (expected match), item 19 of the versioned inventory (contract decision 14/L14, assertion 38): a spawned child fails on its own single upstream call (HTTP 418 canary); the parent COLLECTS the failure (wait:true) rather than leaving it uncollected. The envelope carries ok:true WITH status:\"error\" — a client that only checks 'ok' reads success, which is the exact, deliberate distinction assertion 38 calls out as separate from decision 14's silent-uncollected-failure case (t13-uncollected-failure-silent-wire-logged-to-file). No barrier needed: the child fails deterministically on its own single call, no concurrency or interrupt race involved at all.",
  "argv": [
    "chat",
    "SCEN:parent spawn a child, collect its failure",
    "--json",
    "--provider",
    "ollama",
    "--model",
    "stub-coder:1b"
  ],
  "environment": {
    "allow": [],
    "set": {
      "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
      "PYTHONUTF8": "1",
      "PYTHONHASHSEED": "0",
      "NO_COLOR": "1",
      "LOHRA_NO_WIZARD": "1",
      "COLUMNS": "80",
      "TZ": "UTC",
      "HOME": "{{home}}",
      "LOHRA_HOME": "{{home}}/.lohra",
      "CODEX_HOME": "{{home}}/codex",
      "TMPDIR": "{{home}}/tmp"
    }
  },
  "preconditions": [
    {
      "kind": "tcp-port-closed",
      "host": "127.0.0.1",
      "port": 11434
    }
  ],
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "oracle-python",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/oracle_driver.py", "single"],
      "cwd": "profile"
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/conversation/candidate-driver.mjs", "single"],
      "cwd": "profile"
    }
  },
  "limits": {
    "timeoutMs": 20000,
    "maxOutputBytes": 16777216
  },
  "capture": {
    "tree": {
      "enabled": false,
      "root": "home",
      "exclude": []
    },
    "sqlite": [],
    "events": [
      {
        "name": "requests",
        "root": "profile",
        "path": "stub-requests.jsonl",
        "format": "jsonl"
      },
      {
        "name": "summary",
        "root": "profile",
        "path": "stub-summary.json",
        "format": "json"
      },
      {
        "name": "assertions",
        "root": "profile",
        "path": "stub-assertions.json",
        "format": "json"
      }
    ]
  },
  "comparisons": [
    {
      "class": "byte",
      "field": "process.exitCode"
    },
    {
      "class": "byte",
      "field": "process.signal"
    },
    {
      "class": "byte",
      "field": "process.stdout"
    },
    {
      "class": "byte",
      "field": "process.stderr"
    },
    {
      "class": "stub",
      "field": "events.summary"
    },
    {
      "class": "stub",
      "field": "events.assertions"
    }
  ],
  "expectations": [
    {
      "side": "both",
      "field": "process.exitCode",
      "value": 0
    },
    {
      "side": "both",
      "field": "process.signal",
      "value": null
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/completed",
      "value": true
    },
    {
      "side": "both",
      "field": "events.assertions",
      "value": {
        "exists": true,
        "records": {
          "valid": true,
          "failures": []
        }
      }
    },
    {
      "side": "both",
      "field": "events.summary",
      "value": {
        "exists": true,
        "records": {
          "gets": 0,
          "posts": 4,
          "sequence": [
            "POST /v1/chat/completions",
            "POST /v1/chat/completions",
            "POST /v1/chat/completions",
            "POST /v1/chat/completions"
          ]
        }
      }
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/tool_calls/1/name",
      "value": "collect_session"
    },
    {
      "side": "both",
      "field": "process.stdout",
      "encoding": "utf8",
      "pointer": "/tool_calls/1/result",
      "value": "{\"ok\": true, \"status\": \"error\", \"output\": \"Error code: 418 - {'error': {'message': 'canary', 'type': 'teapot_error'}}\", \"tokens_in\": 0, \"tokens_out\": 0, \"cache_read_tokens\": 0, \"cache_write_tokens\": 0, \"reasoning_tokens\": 0, \"provider\": \"ollama\", \"model\": \"stub-coder:1b\", \"forced_fallback\": false, \"error_kind\": null, \"retry_after\": null}"
    }
  ],
  "normalizations": [
    {
      "field": "process.stdout",
      "kind": "replace-json-pointer",
      "pointer": "/session_id",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stdout",
      "kind": "replace-regex",
      "pattern": "[0-9a-f]{32}",
      "replacement": "<SUB_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=session: )[0-9a-f]{32}(?=  \\(resume with --session )",
      "replacement": "<SESSION_ID>"
    },
    {
      "field": "process.stderr",
      "kind": "replace-regex",
      "pattern": "(?<=--session )[0-9a-f]{32}(?=\\))",
      "replacement": "<SESSION_ID>"
    }
  ],
  "stub": {
    "state": "up-with-models",
    "fixture": "chat-lane-script",
    "requestLog": {
      "comparedHeaders": [
        "authorization",
        "accept",
        "content-type",
        "host",
        "x-stainless-retry-count"
      ],
      "excludedHeaders": [
        "accept-encoding",
        "connection",
        "content-length",
        "user-agent",
        "x-stainless-lang",
        "x-stainless-package-version",
        "x-stainless-os",
        "x-stainless-arch",
        "x-stainless-runtime",
        "x-stainless-runtime-version",
        "x-stainless-async",
        "x-stainless-read-timeout"
      ]
    },
    "laneSteps": {
      "parent": [
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "spawn_session",
              "argumentsRaw": "{\"prompt\":\"SCEN:kid do it\"}"
            }
          ]
        },
        {
          "kind": "tool_calls",
          "calls": [
            {
              "name": "collect_session",
              "argumentsRaw": "{\"sub_id\":\"__SUB__\",\"wait\":true}"
            }
          ]
        },
        {
          "kind": "text",
          "content": "PARENT-DONE"
        }
      ],
      "kid": [
        {
          "kind": "http_error",
          "status": 418,
          "message": "canary"
        }
      ]
    }
  },
  "scrub": {
    "fixtureTokens": true,
    "operatorCredentials": true
  },
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n",
    "expectedPythonVersion": "3.12.10",
    "expectedPackages": {
      "openai": "3.6.0",
      "httpx": "0.28.1"
    }
  }
}
