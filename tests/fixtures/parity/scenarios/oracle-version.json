{
  "schemaVersion": 1,
  "id": "oracle-version",
  "description": "Self-parity of the pinned oracle version command through Python and TypeScript adapters",
  "argv": ["--version"],
  "environment": {
    "allow": [],
    "set": { "PATH": "/usr/bin:/bin", "PYTHONUTF8": "1", "NO_COLOR": "1" }
  },
  "fixtures": [],
  "runners": {
    "oracle": { "adapter": "python", "executable": "oracle-lohra", "prefixArgs": [] },
    "candidate": { "adapter": "typescript", "executable": "oracle-lohra", "prefixArgs": [] }
  },
  "limits": { "timeoutMs": 10000, "maxOutputBytes": 1048576 },
  "capture": {
    "tree": { "enabled": true, "root": "home", "exclude": [] },
    "sqlite": [],
    "events": []
  },
  "comparisons": [
    { "class": "byte", "field": "process.exitCode" },
    { "class": "byte", "field": "process.signal" },
    { "class": "byte", "field": "process.stdout" },
    { "class": "byte", "field": "process.stderr" },
    { "class": "schema", "field": "tree" }
  ],
  "expectations": [
    { "side": "both", "field": "process.exitCode", "value": 0 },
    { "side": "both", "field": "process.signal", "value": null },
    { "side": "both", "field": "process.stdout", "encoding": "utf8", "value": "lohra 0.0.11\n" },
    { "side": "both", "field": "process.stderr", "encoding": "utf8", "value": "" },
    { "side": "both", "field": "tree", "value": [] }
  ],
  "normalizations": [],
  "oracleGuard": {
    "expectedCommit": "16b4785d803ad0ca364a8a67346a04f949fbf592",
    "expectedVersion": "lohra 0.0.11\n"
  }
}
