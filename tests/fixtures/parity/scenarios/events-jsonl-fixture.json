{
  "schemaVersion": 1,
  "id": "events-jsonl-fixture",
  "description": "Exercises deterministic JSONL capture through both process adapters",
  "argv": [],
  "environment": { "allow": [], "set": { "PATH": "/usr/bin:/bin" } },
  "fixtures": [],
  "runners": {
    "oracle": {
      "adapter": "python",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/event-fixture.mjs"]
    },
    "candidate": {
      "adapter": "typescript",
      "executable": "node",
      "prefixArgs": ["{{projectRoot}}/scripts/parity/event-fixture.mjs"]
    }
  },
  "limits": { "timeoutMs": 10000, "maxOutputBytes": 1048576 },
  "capture": {
    "tree": { "enabled": true, "root": "profile", "exclude": [] },
    "sqlite": [],
    "events": [
      { "name": "lifecycle", "root": "profile", "path": "events.jsonl", "format": "jsonl" }
    ]
  },
  "comparisons": [
    { "class": "byte", "field": "process.exitCode" },
    { "class": "byte", "field": "process.signal" },
    { "class": "byte", "field": "process.stdout" },
    { "class": "byte", "field": "process.stderr" },
    { "class": "schema", "field": "tree" },
    { "class": "format", "field": "events.lifecycle" }
  ],
  "expectations": [
    { "side": "both", "field": "process.exitCode", "value": 0 },
    { "side": "both", "field": "process.signal", "value": null },
    { "side": "both", "field": "process.stdout", "encoding": "utf8", "value": "events written\n" },
    { "side": "both", "field": "process.stderr", "encoding": "utf8", "value": "" },
    {
      "side": "both",
      "field": "events.lifecycle.records",
      "value": [
        { "kind": "started", "sequence": 1 },
        { "kind": "completed", "sequence": 2 }
      ]
    }
  ],
  "normalizations": []
}
